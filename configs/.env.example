# 环境变量配置示例文件
# 复制此文件为 .env 并填入实际值，或直接设置环境变量

# ========================================
# 数据库配置
# ========================================
# 数据库连接字符串 (DSN)
# 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
DATABASE_DSN=root:123456@tcp(127.0.0.1:3306)/go_monolith?charset=utf8mb4&parseTime=True&loc=Local

# ========================================
# Redis 配置
# ========================================
# Redis 密码 (如果 Redis 没有设置密码，留空即可)
CACHE_REDIS_PASSWORD=

# ========================================
# JWT 配置
# ========================================
# JWT 签名密钥 (生产环境请务必使用强随机密钥)
# 可以使用命令生成: openssl rand -base64 32
JWT_SECRET=dev-secret-key-change-in-production
